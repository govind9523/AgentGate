# Public demo. Copy to .env; never commit credentials.
AGENTGATE_ENV=production
AGENTGATE_PUBLIC_DEMO=true
AGENTGATE_DEV_MODE=false
AGENTGATE_DATABASE_URL=sqlite:///./data/agentgate.db
AGENTGATE_POLICY_PATH=policies/demo.yml
AGENTGATE_ALLOWED_HOSTS=["localhost","127.0.0.1","*.hf.space"]
AGENTGATE_RETENTION_DAYS=30
AGENTGATE_LOG_LEVEL=INFO
AGENTGATE_OTEL_ENABLED=false
# Opt in to public GitHub/OSV requests from the Research view.
AGENTGATE_RESEARCH_ENABLED=false
# Optional personal Gemini key: used only by authenticated administrator runs.
# AGENTGATE_RESEARCH_API_KEY=
AGENTGATE_RESEARCH_MODEL=gemini-2.5-flash
# Operator mode: set PUBLIC_DEMO=false and use distinct random secrets (32+ chars).
# AGENTGATE_API_TOKEN=
# AGENTGATE_ADMIN_TOKEN=
# Development identity is local only and forbidden when ENV=production.
